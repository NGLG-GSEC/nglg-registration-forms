# Copy to .env (never commit .env) and fill in.

# Admin panel password (/admin). Use a long, unique password.
ADMIN_PASSWORD=
# Random string used to sign the admin login cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Where the SQLite database file lives. Must be on persistent storage.
DATABASE_FILE=./data/registrations.db
PORT=3000
# Set to true when running behind a reverse proxy / hosting platform (HTTPS).
TRUST_PROXY=true

# --- Confirmation email (SMTP) ---
# Google Workspace / Gmail: smtp.gmail.com, port 465, the account's address
# and a 16-character App Password (Google Account -> Security -> App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Εθνική Μεγάλη Στοά της Ελλάδος
# Optional: receive a short notification for every registration.
ORGANIZER_EMAIL=
# Optional: blind copy of every confirmation email.
MAIL_BCC=
